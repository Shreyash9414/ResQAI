# =================================================================
# ResQAI Platform — Environment Configuration Template
# =================================================================

# --- FRONTEND (Vite / Vercel) ---
# In development (npm run dev), these can remain unset to use the built-in Vite dev proxy.
# In production on Vercel, set these to your deployed Render backend URL (e.g., https://resqai-backend.onrender.com)
VITE_API_URL=
VITE_SOCKET_URL=

# --- BACKEND (Node.js / Express / Render) ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/disaster_management
JWT_SECRET=resqai_super_secret_jwt_key_2026
FRONTEND_URL=http://localhost:3000

# --- TWILIO SMS NOTIFICATIONS (Optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_DEBUG=true

# --- SMTP / EMAIL DISASTER WARNINGS (Optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ResQAI Emergency Command <alerts@resqai.org>"

# --- AI GEMINI / OPENAI INTEGRATION (Optional) ---
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_PROVIDER=gemini
