# TWILIO REAL SMS CONFIGURATION
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# APPLICATION SETTINGS
PORT=5000
JWT_SECRET=resqai_super_secret_jwt_key_2026
SMS_DEBUG=true
MONGO_URI=mongodb://127.0.0.1:27017/disaster_management
FRONTEND_URL=http://localhost:3000

# NODEMAILER / SMTP CONFIGURATION FOR AUTOMATED DISASTER WARNING EMAILS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@resqai.org
SMTP_PASS=your_smtp_app_password
MAIL_FROM="ResQAI Emergency Command <alerts@resqai.org>"

# AI EMERGENCY CHATBOT CONFIGURATION (Gemini / OpenAI / Local Knowledge Engine)
# If AI_API_KEY is omitted or blank, ResQAI operates automatically via its resilient
# offline Knowledge Engine backed by live MongoDB disaster, hospital & relief camp records.
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_PROVIDER=gemini

# SMART EVACUATION ROUTING (OSRM)
# Defaults to public OpenStreetMap / Project-OSRM service: https://router.project-osrm.org
# For self-hosted on-premise routing servers, specify your custom instance URL:
OSRM_BASE_URL=https://router.project-osrm.org

# METEOROLOGICAL TELEMETRY (Open-Meteo)
# Uses open, keyless global meteorological telemetry from Open-Meteo with 1.1km-11km resolution
# If external weather network is unreachable, RiskAssessmentEngine transparently records
# weatherApiStatus="UNAVAILABLE" and provides transparent baseline evaluations without simulated data.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
